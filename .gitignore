# Python cache files (auto-generated)
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
venv/
env/
ENV/

# IDE settings
.vscode/
.idea/
*.swp
*.swo

# System temp files
.DS_Store
Thumbs.db

# Temp and log files
*.tmp
*.log
*.cache

# C# build intermediate files
csharp_ipc_builder/obj/
*.pdb
*.sdf
*.suo

# ---------------------------------------------------------------------------
# NOT distributed with the source-code repository
# ---------------------------------------------------------------------------

# Training artefacts are distributed with the repository (logs, per-epoch metrics,
# curves, checkpoints).  Two of them are byte-identical duplicates of the weights
# shipped in weights/ and are therefore not stored twice.
training_output/unetpp_res34/unet_train_results/best_model.pth
training_output/yolo26n/yolo_train_results/weights/best.pt
# ... but the training log itself is evidence and must be kept.
!training_output/**/*.log

# Third-party vendor SDKs and manuals (DTStageDriver, Linkam IPC SDK).
# These are redistributed by their manufacturers under their own terms and are
# therefore not re-published here. Obtain them from the hardware vendors.
docs/vendor_sdk/

# Internal note-keeping file listing documentation placeholders
缺失信息.csv

# 99.7 MiB — too large for a Git object; attached to the v1.0.0 release instead.
# Download it into weights/ from the release page.
weights/unetpp_res34_best.pth
